# Writes OUTPUT: a header with KYTY_SHADER_STORE_SOURCE_HASH, the hash of the sources that decide
# what the shader store records (pipelineSerialization.cpp, StoreHeader). LIST names them, one per
# line, relative to ROOT.
if(NOT DEFINED LIST OR NOT DEFINED ROOT OR NOT DEFINED OUTPUT)
	message(FATAL_ERROR "shader_store_key.cmake requires LIST, ROOT and OUTPUT")
endif()
file(STRINGS "${LIST}" inputs)
list(SORT inputs)
set(all "")
foreach(input IN LISTS inputs)
	file(SHA256 "${ROOT}/${input}" digest)
	string(APPEND all "${input}:${digest}\n")
endforeach()
string(SHA256 total "${all}")
string(SUBSTRING "${total}" 0 16 hash)
# Always written: the build runs this only when an input changed, and an output older than its
# inputs would make it run (and rebuild what includes it) on every build.
file(WRITE "${OUTPUT}" "#pragma once\n// Generated by shader_store_key.cmake: do not edit.\n#define KYTY_SHADER_STORE_SOURCE_HASH 0x${hash}ull\n")
